     0
 }
+
+// B601 extension: cached values cannot satisfy this transaction.
+#[unsafe(no_mangle)]
+pub extern "C" fn b601_motor_request_fresh_state(
+    motor: *mut MotorHandle,
+    timeout_ms: u32,
+    out_state: *mut MotorState,
+) -> i32 {
+    if motor.is_null() || out_state.is_null() || timeout_ms == 0 || timeout_ms > 1000 {
+        set_last_error("invalid fresh-state request");
+        return -1;
+    }
+    let motor = lock_motor_inner!(motor, "motor is null");
+    let out = unsafe { &mut *out_state };
+    *out = MotorState::default();
+    match &*motor {
+        MotorHandleInner::Damiao(m) => {
+            match m.request_fresh_state(Duration::from_millis(timeout_ms as u64)) {
+                Ok(Some(state)) => {
+                    *out = MotorState {
+                        has_value: 1, can_id: state.can_id,
+                        arbitration_id: state.arbitration_id,
+                        status_code: state.status_code, pos: state.pos,
+                        vel: state.vel, torq: state.torq,
+                        t_mos: state.t_mos, t_rotor: state.t_rotor,
+                    };
+                    0
+                },
+                Ok(None) => { set_last_error("fresh motor feedback timed out"); -1 },
+                Err(e) => { set_last_error(e.to_string()); -1 },
+            }
+        },
+        _ => { set_last_error("fresh-state extension is Damiao-only"); -1 },
+    }
+}
